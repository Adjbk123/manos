<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        {% if font_regular is defined %}
        @font-face { font-family: 'CenturyGothic'; src: url('{{ font_regular }}') format('truetype'); font-weight: normal; }
        {% endif %}
        {% if font_bold is defined %}
        @font-face { font-family: 'CenturyGothic'; src: url('{{ font_bold }}') format('truetype'); font-weight: bold; }
        {% endif %}
        @page { margin: 30px; }
        body { font-family: 'CenturyGothic', Helvetica, Arial, sans-serif; color: #1a1a1a; font-size: 10pt; line-height: 1.2; margin: 0; padding: 0; }
        
        .page-header { width: 100%; margin-bottom: 20px; }
        .main-title { font-size: 32pt; font-weight: 900; color: #000; letter-spacing: -1px; margin: 0; padding: 0; line-height: 1; text-transform: uppercase; }
        
        .logo-box { width: 140px; height: 100px; border: 1px solid #ddd; position: absolute; top: 0; right: 0; text-align: center; line-height: 100px; color: #999; font-weight: bold; font-size: 14pt; }
        
        .info-box { width: 500px; margin-top: 10px; border-collapse: collapse; }
        .info-box td { border: 1px solid #ccc; padding: 5px 10px; background-color: #f7f7f7; height: 25px; }
        .info-label { font-size: 9pt; font-weight: bold; width: 140px; text-transform: uppercase; color: #2c3e50; }
        .info-value { font-size: 10pt; font-weight: bold; }
        
        .main-table { width: 100%; border-collapse: collapse; margin-top: 30px; }
        .main-table th { background-color: #2c3e50; color: #ffffff; padding: 10px; text-align: left; font-size: 8pt; font-weight: bold; text-transform: uppercase; border: 1px solid #222; }
        .main-table td { padding: 10px; border: 1px solid #ccc; font-size: 10pt; height: 35px; }
        .main-table tr:nth-child(even) { background-color: #fcfcfc; }
        
        .text-right { text-align: right; }
        .text-center { text-align: center; }
        .font-black { font-weight: 900; }
        
        .amount-pos { color: #27ae60; }
        .amount-neg { color: #c0392b; }
        
        .footer-section { margin-top: 40px; }
        .notes-box { width: 60%; background-color: #fdf5e6; border: 1px solid #ddd; padding: 15px; font-size: 9pt; height: 80px; }
        .signature-box { width: 35%; float: right; border: 1px solid #ccc; padding: 15px; text-align: center; }
        
        .footer-text { position: fixed; bottom: 0; left: 0; right: 0; text-align: center; font-size: 7pt; color: #999; }
        .account-tag { display: inline-block; padding: 2px 6px; background-color: #e9ecef; border-radius: 4px; font-size: 7pt; margin-top: 5px; color: #495057; font-weight: bold; }
    </style>
</head>
<body>
    <div class="logo-box" style="border: none;">
        {% if logo_path %}
            <img src="{{ logo_path }}" style="width: 100%; height: auto;">
        {% else %}
            LOGO
        {% endif %}
    </div>
    
    <div class="page-header">
        <h1 class="main-title">RAPPORT JOURNALIER</h1>
        
        <table class="info-box">
            <tr>
                <td class="info-label">PÉRIODE :</td>
                <td class="info-value">JOURNÉE DU {{ date|date('d / m / Y') }}</td>
            </tr>
            <tr>
                <td class="info-label">GÉNÉRÉ LE :</td>
                <td class="info-value">{{ "now"|date('d/m/Y à H:i') }}</td>
            </tr>
            <tr>
                <td class="info-label">ÉTABLI PAR :</td>
                <td class="info-value">SYSTÈME MANOS AUTOMATISÉ</td>
            </tr>
        </table>
    </div>

    <table class="main-table">
        <thead>
            <tr>
                <th style="width: 25%;">COMPTE / CAISSE</th>
                <th class="text-right">OUVERTURE</th>
                <th class="text-right">ENTRÉES (+)</th>
                <th class="text-right">SORTIES (-)</th>
                <th class="text-right">VENTES (*)</th>
                <th class="text-right">SOLDE FINAL</th>
            </tr>
        </thead>
        <tbody>
            {% for item in reportData %}
            <tr>
                <td>
                    <div class="font-black">{{ item.accountName }}</div>
                    <div class="account-tag">{{ item.accountType }}</div>
                </td>
                <td class="text-right">{{ item.openingBalance|number_format(0, '.', ' ') }} F</td>
                <td class="text-right amount-pos font-black">+{{ item.totalDepots|number_format(0, '.', ' ') }} F</td>
                <td class="text-right amount-neg font-black">-{{ item.totalRetraits|number_format(0, '.', ' ') }} F</td>
                <td class="text-right font-black" style="color: #2980b9;">{{ item.totalVentes|number_format(0, '.', ' ') }} F</td>
                <td class="text-right font-black" style="background-color: #f1f8ff; border-left: 2px solid #2c3e50;">
                    {{ item.closingBalance|number_format(0, '.', ' ') }} F
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="footer-section">
        <div style="float: left; width: 60%;">
            <div class="notes-box">
                <strong>OBSERVATIONS :</strong><br>
                <span style="color: #666; font-size: 8pt;">
                    Ce rapport cumule l'ensemble des transactions monétaires enregistrées sur la période. 
                    Il inclut les ventes directes, les approvisionnements de stock et les mouvements manuels de caisse.
                </span>
            </div>
        </div>
        
        <div class="signature-box">
            <div style="font-size: 8pt; font-weight: bold; border-bottom: 1px solid #eee; margin-bottom: 40px; padding-bottom: 5px;">CACHET & SIGNATURE</div>
            <div style="color: #999; font-size: 7pt; font-style: italic;">Visa de la direction</div>
        </div>
    </div>

    <div class="footer-text">
        MANOS PHONE - Rapport d'activité confidentiel. Toute reproduction sans autorisation est interdite. Page 1/1
    </div>
</body>
</html>
