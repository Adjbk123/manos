<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        @font-face {
            font-family: 'Century Gothic';
            src: url('{{ absolute_url(asset('fonts/century-gothic/centurygothic.ttf')) }}') format('truetype');
            font-weight: 400;
        }
        @font-face {
            font-family: 'Century Gothic';
            src: url('{{ absolute_url(asset('fonts/century-gothic/centurygothic_bold.ttf')) }}') format('truetype');
            font-weight: 700;
        }
        @page { margin: 30px; }
        body { font-family: 'Century Gothic', Helvetica, Arial, sans-serif; color: #1a1a1a; font-size: 10pt; line-height: 1.2; margin: 0; padding: 0; }
        
        /* Top Header Section */
        .page-header { width: 100%; margin-bottom: 20px; }
        .main-title { font-size: 42pt; font-weight: 900; color: #000; letter-spacing: -1px; margin: 0; padding: 0; line-height: 1; }
        
        .logo-box { width: 140px; height: 100px; position: absolute; top: 0; right: 0; text-align: center; }
        
        /* Info Box */
        .info-box { width: 500px; margin-top: 10px; border-collapse: collapse; }
        .info-box td { border: 1px solid #ccc; padding: 5px 10px; background-color: #fdf5e6; height: 25px; }
        .info-label { font-size: 9pt; font-weight: bold; width: 120px; text-transform: uppercase; }
        .info-value { font-size: 10pt; }
        
        /* Main Table */
        .inventory-table { width: 100%; border-collapse: collapse; margin-top: 30px; }
        .inventory-table th { background-color: #2c3e50; color: #ffffff; padding: 8px 10px; text-align: left; font-size: 8pt; font-weight: bold; text-transform: uppercase; border: 1px solid #222; }
        .inventory-table td { padding: 8px 10px; border: 1px solid #ccc; font-size: 9pt; height: 28px; }
        
        .text-right { text-align: right; }
        .text-center { text-align: center; }
        .font-black { font-weight: 900; }
        
        /* Footer Banner */
        .footer-summary { margin-top: 20px; float: right; width: 300px; background-color: #2c3e50; color: white; padding: 15px; border-radius: 4px; }
        .footer-summary-label { font-size: 8pt; opacity: 0.8; text-transform: uppercase; margin-bottom: 5px; }
        .footer-summary-value { font-size: 18pt; font-weight: bold; }
        
        .footer-text { position: fixed; bottom: 0; left: 0; right: 0; text-align: center; font-size: 7pt; color: #999; }
    </style>
</head>
<body>
    <div class="logo-box">
        {% if logo_path %}
            <img src="{{ logo_path }}" style="width: 100%; height: auto;">
        {% endif %}
    </div>
    
    <div class="page-header">
        <h1 class="main-title">INVENTAIRE</h1>
        
        <table class="info-box">
            <tr>
                <td class="info-label">RÉALISÉ PAR :</td>
                <td class="info-value">ADMINISTRATEUR MANOS</td>
            </tr>
            <tr>
                <td class="info-label">DATE :</td>
                <td class="info-value">{{ date|date('d / m / Y') }}</td>
            </tr>
        </table>
    </div>

    <table class="inventory-table">
        <thead>
            <tr>
                <th style="width: 35%;">NOM DE L'ARTICLE</th>
                <th style="width: 25%;">DESCRIPTION / CATÉGORIE</th>
                <th style="width: 12%;" class="text-center">QUANTITÉ</th>
                <th style="width: 13%;" class="text-right">P.U. (ACHAT)</th>
                <th style="width: 15%;" class="text-right">VALEUR STOCK</th>
            </tr>
        </thead>
        <tbody>
            {% for product in products %}
            {% set lastPA = product.getLastPurchasePrice() ?: 0 %}
            <tr>
                <td class="font-black">{{ product.name }}</td>
                <td>{{ product.category.name|default('—') }}</td>
                <td class="text-center font-black">{{ product.stockQuantity }}</td>
                <td class="text-right">{{ lastPA|number_format(0, '.', ' ') }}</td>
                <td class="text-right font-black">{{ (product.stockQuantity * lastPA)|number_format(0, '.', ' ') }}</td>
            </tr>
            {% endfor %}
            
            {% if products|length < 15 %}
                {% for i in range(products|length + 1, 15) %}
                <tr>
                    <td>&nbsp;</td>
                    <td>&nbsp;</td>
                    <td>&nbsp;</td>
                    <td>&nbsp;</td>
                    <td>&nbsp;</td>
                </tr>
                {% endfor %}
            {% endif %}
        </tbody>
    </table>

    <div class="footer-summary">
        <div class="footer-summary-label">VALEUR TOTALE DU STOCK (F CFA)</div>
        <div class="footer-summary-value text-right">{{ totalStockValue|number_format(0, '.', ' ') }}</div>
    </div>

    <div class="footer-text">
        Document généré par MANOS PHONE le {{ "now"|date('d/m/Y H:i') }} - Logiciel de gestion d'inventaire.
    </div>
</body>
</html>
