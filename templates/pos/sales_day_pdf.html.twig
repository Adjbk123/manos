<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        @font-face {
            font-family: 'Century Gothic';
            src: url('{{ absolute_url(asset('fonts/century-gothic/centurygothic.ttf')) }}') format('truetype');
            font-weight: 400;
        }
        @font-face {
            font-family: 'Century Gothic';
            src: url('{{ absolute_url(asset('fonts/century-gothic/centurygothic_bold.ttf')) }}') format('truetype');
            font-weight: 700;
        }

        @page { margin: 28px 32px; }
        * { box-sizing: border-box; }
        body { font-family: 'Century Gothic', Helvetica, Arial, sans-serif; color: #1a1a1a; font-size: 9.5pt; line-height: 1.3; margin: 0; padding: 0; }

        /* ─── HEADER ─────────────────────────────── */
        .header { width: 100%; margin-bottom: 16px; position: relative; min-height: 80px; }
        .logo-box { position: absolute; top: 0; right: 0; width: 130px; }
        .logo-box img { width: 100%; height: auto; }
        .main-title { font-size: 22pt; font-weight: bold; color: #1e293b; letter-spacing: -0.5px; margin: 0 0 2px 0; text-transform: uppercase; }
        .sub-title { font-size: 10pt; color: #64748b; margin: 0 0 10px 0; font-weight: normal; }
        .info-table { border-collapse: collapse; width: 420px; }
        .info-table td { padding: 4px 10px; font-size: 8.5pt; border: 1px solid #cbd5e1; background: #f8fafc; }
        .info-label { font-weight: bold; text-transform: uppercase; color: #475569; width: 130px; font-size: 7.5pt; letter-spacing: 0.4px; }
        .info-value { font-weight: bold; color: #0f172a; }

        /* ─── SECTION TITLE ──────────────────────── */
        .section-title { font-size: 7.5pt; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; color: #fff; background: #1e293b; padding: 5px 10px; margin: 16px 0 0 0; }

        /* ─── TABLE BASE ─────────────────────────── */
        table.data { width: 100%; border-collapse: collapse; }
        table.data th { background: #334155; color: #fff; padding: 7px 9px; text-align: left; font-size: 7.5pt; font-weight: bold; text-transform: uppercase; letter-spacing: 0.4px; }
        table.data td { padding: 7px 9px; border-bottom: 1px solid #e2e8f0; font-size: 8.5pt; vertical-align: middle; }
        table.data tr:last-child td { border-bottom: none; }
        table.data tbody tr:nth-child(even) td { background: #f8fafc; }
        table.data tfoot td { background: #f1f5f9; font-weight: bold; border-top: 2px solid #334155; font-size: 9pt; }

        /* ─── DATE SEPARATOR ─────────────────────── */
        .date-sep td { background: #e2e8f0 !important; font-weight: bold; font-size: 8pt; color: #334155; padding: 4px 9px; border-bottom: none; }

        .text-right  { text-align: right; }
        .text-center { text-align: center; }
        .fw-bold     { font-weight: bold; }
        .text-green  { color: #16a34a; }
        .text-red    { color: #dc2626; }
        .text-muted  { color: #94a3b8; }

        .badge { display: inline-block; padding: 1px 6px; border-radius: 20px; font-size: 7pt; font-weight: bold; text-transform: uppercase; }
        .badge-cash    { background: #dbeafe; color: #1d4ed8; }
        .badge-momo    { background: #fef9c3; color: #92400e; }
        .badge-credit  { background: #fee2e2; color: #991b1b; }
        .badge-paid    { background: #dcfce7; color: #166534; }
        .badge-partial { background: #ffedd5; color: #9a3412; }

        .footer { position: fixed; bottom: 0; left: 0; right: 0; text-align: center; font-size: 7pt; color: #94a3b8; border-top: 1px solid #e2e8f0; padding-top: 4px; }
    </style>
</head>
<body>

    <!-- HEADER -->
    <div class="header">
        <div class="logo-box">{% if logo_path %}<img src="{{ logo_path }}">{% endif %}</div>
        <p class="main-title">Journal des Ventes</p>
        {% if startDate|date('Y-m-d') == endDate|date('Y-m-d') %}
            <p class="sub-title">Journée du {{ startDate|date('d/m/Y') }}</p>
        {% else %}
            <p class="sub-title">Du {{ startDate|date('d/m/Y') }} au {{ endDate|date('d/m/Y') }}</p>
        {% endif %}
        <table class="info-table">
            <tr>
                <td class="info-label">Boutique</td>
                <td class="info-value">MANOS PHONE – CENTRALE</td>
            </tr>
            <tr>
                <td class="info-label">Période</td>
                {% if startDate|date('Y-m-d') == endDate|date('Y-m-d') %}
                    <td class="info-value">{{ startDate|date('d/m/Y') }}</td>
                {% else %}
                    <td class="info-value">{{ startDate|date('d/m/Y') }} → {{ endDate|date('d/m/Y') }}</td>
                {% endif %}
            </tr>
            <tr>
                <td class="info-label">Nb. transactions</td>
                <td class="info-value">{{ sales|length }} vente(s) &nbsp;·&nbsp; Total : {{ totalAmount|number_format(0, '.', ' ') }} F &nbsp;·&nbsp; Encaissé : {{ totalPaid|number_format(0, '.', ' ') }} F</td>
            </tr>
        </table>
    </div>

    {% if sales is empty %}
        <p style="text-align:center;color:#94a3b8;margin-top:40px;font-size:11pt;">Aucune vente enregistrée sur cette période.</p>
    {% else %}

    {# ═══════════════════════════════════════════════════════
       TABLEAU 1 — PRODUITS VENDUS
    ═══════════════════════════════════════════════════════ #}
    <div class="section-title">Produits vendus sur la période</div>
    <table class="data">
        <thead>
            <tr>
                <th style="width:35%;">Produit</th>
                <th style="width:18%;">Catégorie</th>
                <th style="width:9%;" class="text-center">Qté</th>
                <th style="width:13%;" class="text-right">P.U. vente</th>
                <th style="width:13%;" class="text-right">Revenu</th>
                <th style="width:12%;" class="text-right">Marge</th>
            </tr>
        </thead>
        <tbody>
            {% for pid, p in byProduct %}
            <tr>
                <td class="fw-bold">{{ p.name }}</td>
                <td class="text-muted">{{ p.category }}</td>
                <td class="text-center fw-bold">{{ p.qty }}</td>
                <td class="text-right">{{ p.unitPrice|number_format(0, '.', ' ') }} F</td>
                <td class="text-right fw-bold">{{ p.revenue|number_format(0, '.', ' ') }} F</td>
                <td class="text-right {{ p.profit >= 0 ? 'text-green' : 'text-red' }}">
                    {{ p.profit >= 0 ? '+' : '' }}{{ p.profit|number_format(0, '.', ' ') }} F
                </td>
            </tr>
            {% endfor %}
        </tbody>
        <tfoot>
            <tr>
                <td colspan="2">TOTAL</td>
                <td class="text-center">{{ byProduct|map(p => p.qty)|reduce((carry, v) => carry + v, 0) }}</td>
                <td></td>
                <td class="text-right">{{ totalAmount|number_format(0, '.', ' ') }} F</td>
                <td class="text-right text-green">+{{ byProduct|map(p => p.profit)|reduce((carry, v) => carry + v, 0)|number_format(0, '.', ' ') }} F</td>
            </tr>
        </tfoot>
    </table>

    {# ═══════════════════════════════════════════════════════
       TABLEAU 2 — RÉCAP PAR JOURNÉE (si période > 1 jour)
    ═══════════════════════════════════════════════════════ #}
    {% if byDate|length > 1 %}
    <div class="section-title">Récapitulatif par journée</div>
    <table class="data">
        <thead>
            <tr>
                <th style="width:22%;">Date</th>
                <th style="width:13%;" class="text-center">Nb ventes</th>
                <th style="width:22%;" class="text-right">Total</th>
                <th style="width:22%;" class="text-right">Encaissé</th>
                <th style="width:21%;" class="text-right">En attente</th>
            </tr>
        </thead>
        <tbody>
            {% for key, row in byDate %}
            <tr>
                <td class="fw-bold">{{ row.date|date('d/m/Y') }}</td>
                <td class="text-center">{{ row.count }}</td>
                <td class="text-right fw-bold">{{ row.amount|number_format(0, '.', ' ') }} F</td>
                <td class="text-right text-green">{{ row.paid|number_format(0, '.', ' ') }} F</td>
                <td class="text-right text-red">{{ (row.amount - row.paid)|number_format(0, '.', ' ') }} F</td>
            </tr>
            {% endfor %}
        </tbody>
        <tfoot>
            <tr>
                <td>TOTAL</td>
                <td class="text-center">{{ sales|length }}</td>
                <td class="text-right">{{ totalAmount|number_format(0, '.', ' ') }} F</td>
                <td class="text-right text-green">{{ totalPaid|number_format(0, '.', ' ') }} F</td>
                <td class="text-right text-red">{{ totalPending|number_format(0, '.', ' ') }} F</td>
            </tr>
        </tfoot>
    </table>
    {% endif %}

    {# ═══════════════════════════════════════════════════════
       TABLEAU 3 — DÉTAIL DES TRANSACTIONS
    ═══════════════════════════════════════════════════════ #}
    <div class="section-title">Détail des transactions</div>
    <table class="data">
        <thead>
            <tr>
                <th style="width:6%;">#</th>
                <th style="width:10%;">Heure</th>
                <th style="width:26%;">Client</th>
                <th style="width:12%;" class="text-center">Paiement</th>
                <th style="width:10%;" class="text-center">Statut</th>
                <th style="width:18%;" class="text-right">Montant</th>
                <th style="width:18%;" class="text-right">Encaissé</th>
            </tr>
        </thead>
        <tbody>
            {% set currentDay = null %}
            {% for sale in sales %}
            {% set saleDay = sale.date|date('Y-m-d') %}
            {% if byDate|length > 1 and saleDay != currentDay %}
                <tr class="date-sep"><td colspan="7">{{ sale.date|date('l d/m/Y') }}</td></tr>
                {% set currentDay = saleDay %}
            {% endif %}
            {% set isCredit = sale.paidAmount < sale.totalAmount %}
            <tr>
                <td class="fw-bold text-muted">{{ sale.id }}</td>
                <td class="fw-bold">{{ sale.date|date('H:i') }}</td>
                <td>
                    <div class="fw-bold">{{ sale.clientName ?? (sale.stockClient ? sale.stockClient.name : 'Client comptant') }}</div>
                    {% if sale.saleZone %}<div class="text-muted" style="font-size:7pt;">{{ sale.saleZone.name }}</div>{% endif %}
                </td>
                <td class="text-center">
                    {% if sale.paymentMethod == 'CASH' %}<span class="badge badge-cash">Cash</span>
                    {% elseif sale.paymentMethod == 'MOMO' %}<span class="badge badge-momo">MoMo</span>
                    {% else %}<span class="badge badge-credit">Crédit</span>{% endif %}
                </td>
                <td class="text-center">
                    {% if isCredit %}<span class="badge badge-partial">Partiel</span>
                    {% else %}<span class="badge badge-paid">Payé</span>{% endif %}
                </td>
                <td class="text-right fw-bold">{{ sale.totalAmount|number_format(0, '.', ' ') }} F</td>
                <td class="text-right fw-bold {{ isCredit ? 'text-red' : 'text-green' }}">
                    {{ sale.paidAmount|number_format(0, '.', ' ') }} F
                    {% if isCredit %}<div style="font-size:7pt;color:#f97316;">–{{ (sale.totalAmount - sale.paidAmount)|number_format(0, '.', ' ') }} F</div>{% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
        <tfoot>
            <tr>
                <td colspan="5">TOTAL — {{ sales|length }} transaction(s)</td>
                <td class="text-right">{{ totalAmount|number_format(0, '.', ' ') }} F</td>
                <td class="text-right text-green">{{ totalPaid|number_format(0, '.', ' ') }} F</td>
            </tr>
        </tfoot>
    </table>

    {% endif %}

    <div class="footer">
        Document confidentiel · MANOS PHONE · Généré le {{ "now"|date('d/m/Y à H:i') }}
    </div>

</body>
</html>
