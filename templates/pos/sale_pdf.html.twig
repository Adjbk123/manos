<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        {% if font_regular is defined %}
        @font-face { font-family: 'CenturyGothic'; src: url('{{ font_regular }}') format('truetype'); font-weight: normal; }
        {% endif %}
        {% if font_bold is defined %}
        @font-face { font-family: 'CenturyGothic'; src: url('{{ font_bold }}') format('truetype'); font-weight: bold; }
        {% endif %}
        @page { margin: 30px; }
        body { font-family: 'CenturyGothic', Helvetica, Arial, sans-serif; color: #1a1a1a; font-size: 10pt; line-height: 1.2; margin: 0; padding: 0; }
        
        .page-header { width: 100%; margin-bottom: 20px; position: relative; }
        .main-title { font-size: 32pt; font-weight: 900; color: #000; letter-spacing: -1px; margin: 0; padding: 0; line-height: 1; text-transform: uppercase; }
        
        .logo-box { width: 140px; height: 100px; position: absolute; top: 0; right: 0; text-align: right; }
        
        .info-box { width: 450px; margin-top: 10px; border-collapse: collapse; }
        .info-box td { border: 1px solid #ccc; padding: 5px 10px; background-color: #f0f4f8; height: 25px; }
        .info-label { font-size: 8pt; font-weight: bold; width: 130px; text-transform: uppercase; color: #2c3e50; }
        .info-value { font-size: 10pt; font-weight: bold; }
        
        .main-table { width: 100%; border-collapse: collapse; margin-top: 30px; }
        .main-table th { background-color: #2c3e50; color: #ffffff; padding: 10px; text-align: left; font-size: 8pt; font-weight: bold; text-transform: uppercase; border: 1px solid #222; }
        .main-table td { padding: 10px; border: 1px solid #ccc; font-size: 9pt; }
        .main-table tr:nth-child(even) { background-color: #f9f9f9; }
        
        .text-right { text-align: right; }
        .text-center { text-align: center; }
        .font-black { font-weight: bold; }
        
        .summary-container { margin-top: 20px; width: 100%; }
        .summary-table { width: 350px; float: right; border-collapse: collapse; background-color: #2c3e50; color: white; }
        .summary-table td { padding: 10px 15px; border-bottom: 1px solid rgba(255,255,255,0.1); }
        .summary-label { font-size: 8pt; opacity: 0.8; text-transform: uppercase; }
        .summary-value { font-size: 12pt; font-weight: bold; text-align: right; }
        .total-row td { background-color: #1a252f; border-top: 2px solid #fff; }
        .total-value { font-size: 18pt; }
        
        .clear { clear: both; }
        .footer-text { position: fixed; bottom: 0; left: 0; right: 0; text-align: center; font-size: 7pt; color: #999; }
        .text-primary { color: #2c3e50; }
    </style>
</head>
<body>
    <div class="logo-box">
        {% if logo_path %}
            <img src="{{ logo_path }}" style="max-width: 140px; max-height: 100px;">
        {% else %}
            <div style="border: 1px solid #ddd; height: 100px; line-height: 100px; text-align: center; color: #999;">MANOS PHONE</div>
        {% endif %}
    </div>
    
    <div class="page-header">
        <h1 class="main-title">FACTURE</h1>
        
        <table class="info-box">
            <tr>
                <td class="info-label">RÉFÉRENCE :</td>
                <td class="info-value text-primary">#{{ sale.reference|default('VEN-' ~ sale.id) }}</td>
            </tr>
            <tr>
                <td class="info-label">CLIENT :</td>
                <td class="info-value">{{ sale.stockClient.name|default(sale.clientName|default('Client de passage')) }}</td>
            </tr>
            <tr>
                <td class="info-label">DATE VENTE :</td>
                <td class="info-value">{{ sale.date|date('d/m/Y à H:i') }}</td>
            </tr>
            <tr>
                <td class="info-label">RÈGLEMENT :</td>
                <td class="info-value">
                    {% set method = sale.paymentMethod|default('CASH') %}
                    {{ method == 'CASH' ? 'ESPÈCES' : (method == 'MOMO' ? 'MOBILE MONEY' : method) }}
                </td>
            </tr>
        </table>
    </div>

    <table class="main-table">
        <thead>
            <tr>
                <th style="width: 45%;">DÉSIGNATION / ARTICLE</th>
                <th style="width: 15%;" class="text-center">QUANTITÉ</th>
                <th style="width: 20%;" class="text-right">P.U. VENTE</th>
                <th style="width: 20%;" class="text-right">TOTAL LIGNE</th>
            </tr>
        </thead>
        <tbody>
            {% for item in sale.saleItems %}
            <tr>
                <td>
                    <div class="font-black">{{ item.stockBatch.product.name|default('Produit supprimé') }}</div>
                </td>
                <td class="text-center font-black">{{ item.quantity }}</td>
                <td class="text-right">{{ (item.unitSellingPrice|default(0))|number_format(0, '.', ' ') }} F</td>
                <td class="text-right font-black">
                    {{ (item.quantity * item.unitSellingPrice|default(0))|number_format(0, '.', ' ') }} F
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="summary-container">
        <table class="summary-table">
            <tr>
                <td class="summary-label">TOTAL NET À PAYER</td>
                <td class="summary-value">{{ (sale.totalAmount|default(0))|number_format(0, '.', ' ') }} F</td>
            </tr>
            <tr>
                <td class="summary-label">MONTANT REÇU</td>
                <td class="summary-value">{{ (sale.paidAmount|default(0))|number_format(0, '.', ' ') }} F</td>
            </tr>
            <tr class="total-row">
                {% set total = sale.totalAmount|default(0) %}
                {% set paid = sale.paidAmount|default(0) %}
                {% set balance = total - paid %}
                {% if balance > 0 %}
                    <td class="summary-label">RESTE À PAYER (DETTE)</td>
                    <td class="summary-value total-value">{{ balance|number_format(0, '.', ' ') }} F</td>
                {% else %}
                    <td class="summary-label">MONNAIE RENDUE</td>
                    <td class="summary-value total-value">{{ (paid - total)|number_format(0, '.', ' ') }} F</td>
                {% endif %}
            </tr>
        </table>
    </div>
    <div class="clear"></div>

    <div class="footer-text">
        Merci de votre confiance ! - Facture générée le {{ "now"|date('d/m/Y à H:i') }}.
    </div>
</body>
</html>
